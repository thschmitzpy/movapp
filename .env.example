# ==============================================================================
# movapp — variaveis de ambiente
# ------------------------------------------------------------------------------
# Uso: cp .env.example .env  -> editar valores locais.
# O arquivo .env e gitignored e nunca deve ser committado.
# ==============================================================================

# --- Banco de dados ---
POSTGRES_DB=movapp
POSTGRES_USER=movapp
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY

# Ao rodar via docker compose, o host do banco e o servico "postgres".
# Ao rodar a app fora do compose (IntelliJ/mvn), aponte para localhost:5432
# ou para o host que voce usa localmente.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/movapp
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# --- JWT (minimo 256 bits para HS256) ---
# Gere um novo com: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_gere_com_openssl_rand_base64_48_no_minimo_256_bits_de_comprimento
JWT_EXPIRATION=86400000

# --- Usuarios iniciais (InMemoryUserDetailsManager) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY
USER_USERNAME=usuario
USER_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY

# --- Perfil Spring ---
SPRING_PROFILES_ACTIVE=dev

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY
