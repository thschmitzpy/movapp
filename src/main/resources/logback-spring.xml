<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuração de log condicional ao perfil ativo:
    - dev (e default): saída texto legível, com chaves MDC entre colchetes.
    - prod:            saída JSON estruturada (logstash-logback-encoder),
                       ideal para ingestão em Loki/ELK/CloudWatch.
-->
<configuration>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="movapp"/>

    <springProfile name="dev | default">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <!--
                  %X{key} insere o valor da chave MDC. As que não existem viram vazio.
                  Chaves: requestId, method, path, userId (preenchidas pelo MdcLoggingFilter
                  e pelo JwtAuthenticationFilter).
                -->
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [req=%X{requestId:-} user=%X{userId:-} %X{method:-} %X{path:-}] %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.loja.movapp" level="INFO"/>
    </springProfile>

    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <includeMdcKeyName>method</includeMdcKeyName>
                <includeMdcKeyName>path</includeMdcKeyName>
                <customFields>{"app":"${appName}"}</customFields>
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <message>message</message>
                    <logger>logger</logger>
                    <thread>thread</thread>
                    <level>level</level>
                </fieldNames>
            </encoder>
        </appender>

        <root level="WARN">
            <appender-ref ref="JSON"/>
        </root>
        <logger name="com.loja.movapp" level="INFO"/>
    </springProfile>

</configuration>
